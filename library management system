#include <iostream>
#include <fstream>
#include <vector>
#include <memory>
#include <ctime>

using namespace std;

// Base Class
class MediaItem {
protected:
    int id;
    string title;
    bool checkedOut;
    int dueDays;

public:
    MediaItem(int i, string t)
        : id(i), title(t), checkedOut(false), dueDays(0) {}

    virtual ~MediaItem() {}

    virtual void display() const = 0;

    virtual string getType() const = 0;

    int getId() const {
        return id;
    }

    string getTitle() const {
        return title;
    }

    bool isCheckedOut() const {
        return checkedOut;
    }

    void checkout(int days) {
        if (checkedOut) {
            cout << "Item already checked out!\n";
            return;
        }

        checkedOut = true;
        dueDays = days;

        cout << "Checkout Successful.\n";
    }

    void returnItem(int lateDays) {
        if (!checkedOut) {
            cout << "Item was not issued.\n";
            return;
        }

        checkedOut = false;

        double fine = lateDays * 5.0;

        cout << "Returned Successfully.\n";
        cout << "Fine: Rs." << fine << endl;
    }

    virtual void save(ofstream& fout) {
        fout << getType() << ","
             << id << ","
             << title << ","
             << checkedOut << "\n";
    }
};

// Derived Class - Book
class Book : public MediaItem {
    string author;

public:
    Book(int id, string title, string author)
        : MediaItem(id, title), author(author) {}

    void display() const override {
        cout << "\n[BOOK]\n";
        cout << "ID: " << id << endl;
        cout << "Title: " << title << endl;
        cout << "Author: " << author << endl;
        cout << "Status: "
             << (checkedOut ? "Issued" : "Available")
             << endl;
    }

    string getType() const override {
        return "Book";
    }
};

// Derived Class - Journal
class Journal : public MediaItem {
    int volume;

public:
    Journal(int id, string title, int volume)
        : MediaItem(id, title), volume(volume) {}

    void display() const override {
        cout << "\n[JOURNAL]\n";
        cout << "ID: " << id << endl;
        cout << "Title: " << title << endl;
        cout << "Volume: " << volume << endl;
        cout << "Status: "
             << (checkedOut ? "Issued" : "Available")
             << endl;
    }

    string getType() const override {
        return "Journal";
    }
};

// Library Class
class Library {
private:
    vector<shared_ptr<MediaItem>> catalog;

public:
    void addBook() {
        int id;
        string title, author;

        cout << "Book ID: ";
        cin >> id;
        cin.ignore();

        cout << "Title: ";
        getline(cin, title);

        cout << "Author: ";
        getline(cin, author);

        catalog.push_back(
            make_shared<Book>(id, title, author)
        );

        cout << "Book Added.\n";
    }

    void addJournal() {
        int id, volume;
        string title;

        cout << "Journal ID: ";
        cin >> id;
        cin.ignore();

        cout << "Title: ";
        getline(cin, title);

        cout << "Volume: ";
        cin >> volume;

        catalog.push_back(
            make_shared<Journal>(id, title, volume)
        );

        cout << "Journal Added.\n";
    }

    void displayAll() {
        if (catalog.empty()) {
            cout << "No Items Found.\n";
            return;
        }

        for (auto item : catalog)
            item->display();
    }

    void checkoutItem() {
        int id;

        cout << "Enter Item ID: ";
        cin >> id;

        for (auto item : catalog) {
            if (item->getId() == id) {
                item->checkout(14);
                return;
            }
        }

        cout << "Item Not Found.\n";
    }

    void returnItem() {
        int id;
        int lateDays;

        cout << "Enter Item ID: ";
        cin >> id;

        cout << "Late Days: ";
        cin >> lateDays;

        for (auto item : catalog) {
            if (item->getId() == id) {
                item->returnItem(lateDays);
                return;
            }
        }

        cout << "Item Not Found.\n";
    }

    void saveToFile() {
        ofstream fout("library.txt");

        for (auto item : catalog)
            item->save(fout);

        fout.close();

        cout << "Catalog Saved.\n";
    }
};

int main() {
    Library lib;
    int choice;

    do {
        cout << "\n===== LIBRARY MANAGEMENT SYSTEM =====\n";
        cout << "1. Add Book\n";
        cout << "2. Add Journal\n";
        cout << "3. Display Catalog\n";
        cout << "4. Checkout Item\n";
        cout << "5. Return Item\n";
        cout << "6. Save Catalog\n";
        cout << "7. Exit\n";
        cout << "Choice: ";

        cin >> choice;

        switch (choice) {
            case 1:
                lib.addBook();
                break;

            case 2:
                lib.addJournal();
                break;

            case 3:
                lib.displayAll();
                break;

            case 4:
                lib.checkoutItem();
                break;

            case 5:
                lib.returnItem();
                break;

            case 6:
                lib.saveToFile();
                break;

            case 7:
                cout << "Exiting...\n";
                break;

            default:
                cout << "Invalid Choice!\n";
        }

    } while (choice != 7);

    return 0;
}
